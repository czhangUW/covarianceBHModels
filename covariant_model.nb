Cell[BoxData[
 RowBox[{
  RowBox[{"checkPoisson", "[", 
   RowBox[{"sa_", ",", "sb_", ",", "sRule_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"funs1", ",", "funs2", ",", "result1", ",", "result2"}], "}"}], 
    ",", 
    RowBox[{
     RowBox[{"funs1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Lambda]1", "[", "x", "]"}], "sa"}], "/.", "sRule"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"funs2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Lambda]2", "[", "x", "]"}], "sb"}], "/.", "sRule"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"result1", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"poissonFun", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"funs1", ",", 
             RowBox[{
              RowBox[{"\[Alpha]", "[", "x", "]"}], "funs2"}]}], "}"}], ",", 
           "canonicalPairs"}], "]"}], "//", "Expand"}], ")"}], "/.", 
       RowBox[{
        RowBox[{"Times", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Derivative", "[", "n_", "]"}], "[", "\[Lambda]1", "]"}], 
           "[", "x", "]"}], ",", "b__"}], "]"}], ":>", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "n"], 
         RowBox[{"\[Lambda]1", "[", "x", "]"}], 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"Times", "[", "b", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "n"}], "}"}]}], "]"}]}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"result2", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"poissonFun", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"funs1", ",", "funs2"}], "}"}], ",", "canonicalPairs"}], 
          "]"}], "//", "Expand"}], ")"}], "/.", 
       RowBox[{
        RowBox[{"Times", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Derivative", "[", "n_", "]"}], "[", "\[Lambda]1", "]"}], 
           "[", "x", "]"}], ",", "b__"}], "]"}], ":>", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "n"], 
         RowBox[{"\[Lambda]1", "[", "x", "]"}], 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"Times", "[", "b", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "n"}], "}"}]}], "]"}]}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sa", ",", "sb"}], "}"}], "->", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"result1", "-", 
          RowBox[{
           RowBox[{"\[Alpha]", "[", "x", "]"}], "result2"}]}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Lambda]1", "[", "x", "]"}], "->", 
            RowBox[{
             RowBox[{"\[Mu]", "[", "sa", "]"}], "[", "x", "]"}]}], ",", 
           RowBox[{
            RowBox[{"\[Lambda]2", "[", "x", "]"}], "->", 
            RowBox[{
             RowBox[{"E2", "[", "x", "]"}], 
             RowBox[{"NN", "[", "x", "]"}], 
             RowBox[{
              RowBox[{"F", "[", "sb", "]"}], "[", "x", "]"}]}]}]}], "}"}]}], 
        ")"}]}], "//", "Expand"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.943371145551937*^9, 3.943371299378869*^9}, {
